# Valores públicos: seguros para o browser, desde que RLS esteja ativo.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# QA: noindex,nofollow. Produção: index,follow.
VITE_ROBOTS_DIRECTIVE=noindex,nofollow

# Opcional: necessário apenas ao ativar Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Contacto público e importador legado temporário; não incluir segredos aqui.
VITE_CONTACT_EMAIL=reservas@villavalverde.pt
VITE_BOOKING_IMPORT_ENDPOINT=

# Só para desenvolvimento local e previews explicitamente configurados.
VITE_DEV_SURFACE=public
VITE_PUBLIC_HOST_ALIASES=
VITE_ADMIN_HOST_ALIASES=
